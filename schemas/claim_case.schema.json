{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimCase",
  "type": "object",
  "required": ["case_id", "source_system", "stress_scenario"],
  "properties": {
    "case_id": { "type": "string" },
    "source_system": { "type": "string" },
    "source_task": { "type": "string" },
    "stress_scenario": { "type": "string" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_item" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "native_system_behavior": { "type": "object" },
    "expected_cairnlab_behavior": { "type": "object" },
    "failure_classes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["id", "text", "type"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "state": { "type": "string" },
        "status": { "type": "string" },
        "scope": { "type": "object" },
        "risk": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "evidence_item": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "uri": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "hash": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      }
    },
    "relation": {
      "type": "object",
      "required": ["id", "source", "target", "type"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "criticality": { "type": "string" }
      }
    }
  }
}
