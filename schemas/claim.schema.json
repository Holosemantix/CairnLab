{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "type": "object",
  "required": [
    "id",
    "text",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "observed_state": {
      "description": "Upstream observed claim state imported from an external system.",
      "type": ["string", "null"]
    },
    "authority_state": {
      "description": "CairnLab authority seed state. Stronger states should normally be event-derived.",
      "type": "string",
      "default": "draft"
    },
    "state": {
      "description": "Legacy alias for observed_state.",
      "type": "string"
    },
    "status": {
      "description": "Legacy alias for observed_state.",
      "type": "string"
    }
  }
}
