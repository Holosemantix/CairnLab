{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifierCertificate",
  "type": "object",
  "required": [
    "id",
    "verifier",
    "claim",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "verifier": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "object"
    },
    "can_authorize": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
