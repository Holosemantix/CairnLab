{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateTransition",
  "type": "object",
  "required": [
    "id",
    "claim",
    "from",
    "to",
    "authorized_by"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "authorized_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}